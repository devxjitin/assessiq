# Copy to .env for local development. NEVER commit real secrets.
# In staging/production these come from AWS SSM Parameter Store.

NODE_ENV=development
PORT=4000

# Database (docker compose: infra/docker-compose.yml)
DATABASE_URL=postgresql://assessiq:assessiq@localhost:5432/assessiq

# Redis / queues
REDIS_URL=redis://localhost:6379

# Auth (Sprint 1)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Razorpay (Sprint 3) - use TEST keys only until go-live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AWS (Sprint 0 infra / Sprint 2+ files, email)
AWS_REGION=ap-south-1
S3_BUCKET=

# Payments: fake (simulated, dev/staging only) or razorpay (needs the three values below).
# Encrypts trainers' bank account numbers (32+ characters). Do not change once data exists.
DATA_ENCRYPTION_KEY=
# Secret in the SNS mail-events URL (16+ characters), and the switch for certificate jobs.
SES_EVENTS_KEY=
# Address printed on certificates (QR code and "Verify at" line). Default: the web address.
VERIFY_BASE_URL=https://parakh.nandivex.in
CERT_JOBS_POLL=on
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SES_FROM_EMAIL=no-reply@parakh.nandivex.in

# Judge0 (Sprint 6)
# Coding questions: disabled | fake | judge0
CODE_RUNNER=disabled
JUDGE0_URL=http://localhost:2358
# process works on modern (cgroup v2) hosts; cgroup needs a cgroup v1 host
JUDGE0_LIMIT_MODE=process

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
