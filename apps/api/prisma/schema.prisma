// AssessIQ database schema. Sprint 1 covers identity; exams, payments etc. arrive in later sprints.

generator client {
  provider      = "prisma-client-js"
  // linux-musl-* targets are for the Alpine Docker images (amd64 local, arm64 on the Graviton server).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  EXAMINER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  name              String
  phone             String?
  passwordHash      String
  role              Role
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  examinerProfile ExaminerProfile?
  otps            EmailOtp[]
  refreshTokens   RefreshToken[]

  @@index([role])
}

model ExaminerProfile {
  userId  String  @id @db.Uuid
  orgName String?
  // Trainer's default certificate logo (S3 key); each exam can override it (Sprint 2).
  logoKey String?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailOtp {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  purpose    OtpPurpose
  // HMAC of the code; the code itself is never stored.
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  // Tokens rotated from the same login share a family so reuse can revoke all of them.
  familyId     String    @db.Uuid
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
