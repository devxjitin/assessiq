// AssessIQ database schema. Sprint 1 covers identity; exams, payments etc. arrive in later sprints.

generator client {
  provider      = "prisma-client-js"
  // linux-musl-* targets are for the Alpine Docker images (amd64 local, arm64 on the Graviton server).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  EXAMINER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ExamStatus {
  DRAFT
  PAYMENT_PENDING
  PUBLISHED
  LIVE
  CLOSED
  GRADING
  RESULTS_FINAL
  CERT_PENDING_APPROVAL
  CERT_RELEASED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
}

enum PaymentPurpose {
  EXAM_CREATION
  EXAM_JOIN
}

enum QuestionType {
  SINGLE
  MULTI
  SUBJECTIVE
  CODING
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  name              String
  phone             String?
  passwordHash      String
  role              Role
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  examinerProfile ExaminerProfile?
  otps            EmailOtp[]
  refreshTokens   RefreshToken[]
  exams           Exam[]
  payments        Payment[]

  @@index([role])
}

model Exam {
  id               String     @id @default(uuid()) @db.Uuid
  examinerId       String     @db.Uuid
  title            String
  description      String?
  instructions     String?
  status           ExamStatus @default(DRAFT)
  durationMinutes  Int        @default(60)
  startsAt         DateTime?
  endsAt           DateTime?
  passPercent      Float      @default(40)
  shuffleQuestions Boolean    @default(true)
  shuffleOptions   Boolean    @default(true)
  maxStudents      Int        @default(1000)
  // Certificate logo for this exam (private S3 key). Falls back to the trainer's default logo.
  logoKey          String?
  // Share code (e.g. NVX-7K3P9Q), generated when the creation fee is captured.
  code             String?    @unique
  publishedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  examiner  User       @relation(fields: [examinerId], references: [id], onDelete: Restrict)
  questions Question[]
  payments  Payment[]

  @@index([examinerId, createdAt])
  @@index([status])
}

model Question {
  id             String       @id @default(uuid()) @db.Uuid
  examId         String       @db.Uuid
  position       Int
  type           QuestionType
  body           String
  // Choice questions only: option texts, and the zero-based indexes of the correct ones.
  options        String[]
  correctOptions Int[]
  marks          Float        @default(4)
  negativeMarks  Float        @default(0)
  explanation    String?
  // Subjective questions only: marking guidance for the grader.
  rubric         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, position])
}

model ExaminerProfile {
  userId  String  @id @db.Uuid
  orgName String?
  // Trainer's default certificate logo (S3 key); each exam can override it (Sprint 2).
  logoKey String?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailOtp {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  purpose    OtpPurpose
  // HMAC of the code; the code itself is never stored.
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  // Tokens rotated from the same login share a family so reuse can revoke all of them.
  familyId     String    @db.Uuid
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Payment {
  id                String         @id @default(uuid()) @db.Uuid
  // Human-friendly receipt number, e.g. AIQ-R-000012 (assigned from this sequence).
  receiptNo         Int            @unique @default(autoincrement())
  userId            String         @db.Uuid
  examId            String?        @db.Uuid
  purpose           PaymentPurpose
  // Integer paise. GST-inclusive.
  amountPaise       Int
  currency          String         @default("INR")
  provider          String
  providerOrderId   String         @unique
  providerPaymentId String?        @unique
  status            PaymentStatus  @default(CREATED)
  failureReason     String?
  capturedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  exam Exam? @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([examId, purpose, status])
}

// One row per gateway webhook event; the unique id makes redelivery harmless.
model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String   @unique
  type        String
  receivedAt  DateTime @default(now())
}
